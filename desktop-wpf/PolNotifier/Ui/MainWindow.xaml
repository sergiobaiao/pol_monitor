<Window x:Class="PolNotifier.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POL ADV — Painel de Prazos &amp; Notificações" Width="1100" Height="720" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}" Icon="/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <DockPanel Background="{StaticResource Bg1}">
            <TextBlock DockPanel.Dock="Top" Text="⚖️ POL ADV" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="24,24,20,20"/>
            <TextBlock x:Name="LblUser" DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource FgDim}" Margin="24,16" TextWrapping="Wrap"/>
            <StackPanel>
                <RadioButton Style="{StaticResource NavButton}" Content="📊  Widgets / Início" Tag="Home" IsChecked="True" Checked="OnNav"/>
                <RadioButton Style="{StaticResource NavButton}" Content="📋  Tarefas" Tag="Tasks" Checked="OnNav"/>
                <RadioButton Style="{StaticResource NavButton}" Content="📅  Calendário" Tag="Calendar" Checked="OnNav"/>
                <RadioButton Style="{StaticResource NavButton}" Content="🔔  Notificações" Tag="Notifications" Checked="OnNav"/>
                <RadioButton Style="{StaticResource NavButton}" Content="⚙️  Configurações" Tag="Settings" Checked="OnNav"/>
                <RadioButton Style="{StaticResource NavButton}" Content="📜  Logs &amp; Histórico" Tag="Logs" Checked="OnNav"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <DockPanel Background="{StaticResource Bg1}" Margin="0,0,0,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="24,12" VerticalAlignment="Center">
                    <TextBlock x:Name="LblStatus" Text="🟢 Pronto" FontSize="12" Foreground="#10b981" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnFence" Content="🖥️ Widget Desktop" Style="{StaticResource FlatButton}" Background="#27272a" Margin="0,0,10,0" Click="OnToggleFence"/>
                    <Button x:Name="BtnSync" Content="🔄 Sincronizar Agora" Style="{StaticResource AccentButton}" Click="OnSyncNow"/>
                </StackPanel>
                <StackPanel Margin="24,12">
                    <TextBlock x:Name="LblGreeting" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                    <TextBlock x:Name="LblSubtitle" FontSize="12" Foreground="{StaticResource FgMuted}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="20">
                <!-- INÍCIO -->
                <Grid x:Name="ViewHome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid x:Name="Metrics" Columns="4"/>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Bg1}" CornerRadius="12" Margin="6,0,10,0" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="📋 Prazos e Tarefas Próximas" Style="{StaticResource CardTitle}" Margin="4,4,4,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FeedTasks"/></ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="12" Margin="10,0,6,0" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="📅 Próximos Compromissos &amp; Audiências" Style="{StaticResource CardTitle}" Margin="4,4,4,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FeedEvents"/></ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- TAREFAS -->
                <DockPanel x:Name="ViewTasks" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="TxtSearch" Width="300" Margin="0,0,10,0" TextChanged="OnFilterChanged" ToolTip="Pesquisar em tarefas ou processos"/>
                        <ComboBox x:Name="CmbFilter" Width="170" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Hoje"/>
                            <ComboBoxItem Content="Próximos Dias"/>
                            <ComboBoxItem Content="Semana"/>
                            <ComboBoxItem Content="Atrasadas"/>
                        </ComboBox>
                    </StackPanel>
                    <Border Background="{StaticResource Bg1}" CornerRadius="10" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TasksList"/></ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- CALENDÁRIO -->
                <Border x:Name="ViewCalendar" Visibility="Collapsed" Background="{StaticResource Bg1}" CornerRadius="10" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CalendarList"/></ScrollViewer>
                </Border>

                <!-- NOTIFICAÇÕES -->
                <ScrollViewer x:Name="ViewNotifications" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="ChkEmail" DockPanel.Dock="Right" Content="Ativo"/>
                                    <TextBlock Text="📧 Notificações por E-mail (SMTP)" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Servidor SMTP:" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSmtpHost"/></StackPanel>
                                    <StackPanel Margin="8,0,0,0"><TextBlock Text="Porta:" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSmtpPort"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Usuário / E-mail Remetente:" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSmtpUser"/></StackPanel>
                                    <StackPanel Margin="8,0,0,0"><TextBlock Text="Senha de Aplicativo:" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="TxtSmtpPass"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Destinatários (um ou mais, separados por vírgula ou ;):" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSmtpRecipients"/></StackPanel>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="ChkSmtpSsl" Content="SSL direto (porta 465)" Margin="0,8,0,0"/>
                                        <Button Content="🧪 Testar E-mail" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnTestEmail"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="ChkTelegram" DockPanel.Dock="Right" Content="Ativo"/>
                                    <TextBlock Text="✈️ Notificações por Telegram" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Bot Token (obtido via @BotFather):" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtTgToken"/></StackPanel>
                                    <StackPanel Margin="8,0,0,0"><TextBlock Text="Chat IDs (separados por vírgula):" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtTgChats"/></StackPanel>
                                </UniformGrid>
                                <Button Content="🧪 Testar Telegram" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnTestTelegram"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="ChkWa" DockPanel.Dock="Right" Content="Ativo"/>
                                    <TextBlock Text="💬 Notificações por WhatsApp (OpenWA)" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="URL do Servidor OpenWA:" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtWaUrl"/></StackPanel>
                                    <StackPanel Margin="8,0,0,0"><TextBlock Text="API Key (Opcional):" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtWaKey"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Números WhatsApp (ex: 5511999999999):" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtWaRecipients"/></StackPanel>
                                    <Button Content="🧪 Testar WhatsApp" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnTestWa"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Button Content="💾 Salvar Configurações de Notificação" Style="{StaticResource AccentButton}" Padding="0,11" FontSize="14" Margin="4,16" Click="OnSaveNotifications"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONFIGURAÇÕES -->
                <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🔐 Conta POL ADV (office.pol.adv.br)" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="LblConnected" Foreground="{StaticResource FgMuted}" Margin="0,2,0,4"/>
                                <TextBlock Text="Office ID (Tenant):" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtOffice" Width="260" HorizontalAlignment="Left"/>
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Content="💾 Salvar" Style="{StaticResource AccentButton}" Click="OnSavePol"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔑 Testar Conexão na API" Style="{StaticResource FlatButton}" Click="OnTestPol"/>
                                        <Button Content="🚪 Trocar Usuário" Style="{StaticResource FlatButton}" Margin="8,0" Click="OnLogout"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#27272a" CornerRadius="6" Padding="8,3">
                                        <TextBlock x:Name="LblIntervalBadge" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                                    </Border>
                                    <TextBlock Text="⏱️ Período de Atualizações &amp; Sincronização" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <TextBlock Text="Selecione um intervalo pré-definido:" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                <WrapPanel x:Name="Presets"/>
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                        <TextBlock Text="Minutos:" FontSize="11" Foreground="{StaticResource FgMuted}"/>
                                        <TextBox x:Name="TxtInterval" Width="80" TextChanged="OnIntervalText"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="LblInterval" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgMuted}"/>
                                        <Slider x:Name="SldInterval" Minimum="1" Maximum="480" TickFrequency="5" IsSnapToTickEnabled="False" Margin="0,6,0,0" ValueChanged="OnIntervalSlider"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Disparo Diário Consolidado (HH:MM):" FontSize="12" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtDailyHour" Width="80" Margin="10,0"/>
                                </StackPanel>
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Content="💾 Salvar Período de Atualização" Style="{StaticResource AccentButton}" Click="OnSaveInterval"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔄 Sincronizar Agora" Style="{StaticResource FlatButton}" Click="OnManualSync"/>
                                        <Button Content="📨 Enviar último relatório" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="OnSendReport"
                                                ToolTip="Reenvia agora o último relatório para todos os canais ativos (e-mail, Telegram, WhatsApp)"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock x:Name="LblAccent" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="🎨 Personalização do Widget Desktop (Fences)" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock x:Name="LblW" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="SldW" Minimum="260" Maximum="700" ValueChanged="OnFenceSize"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock x:Name="LblH" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="SldH" Minimum="300" Maximum="900" ValueChanged="OnFenceSize"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="LblAlpha" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldAlpha" Minimum="25" Maximum="100" ValueChanged="OnFenceAlpha"/>
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Content="💾 Salvar Dimensões e Opacidade" Style="{StaticResource AccentButton}" Click="OnSaveFence"/>
                                    <Button Content="↺ Padrões (360x600, 90%)" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="OnResetFence"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🚀 Inicialização e Comportamento da Janela" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAutoStart" Content="Iniciar o POL ADV Notifier junto com o Windows" Margin="0,4"/>
                                <CheckBox x:Name="ChkStartFence" Content="Exibir widget na Área de Trabalho ao iniciar (estilo Fences)" Margin="0,4"/>
                                <CheckBox x:Name="ChkStartMain" Content="Abrir painel principal automaticamente ao iniciar (se desativado, inicia silencioso na bandeja)" Margin="0,4"/>
                                <CheckBox x:Name="ChkMinTray" Content="Minimizar para a bandeja do sistema ao clicar em '_' (oculta da barra de tarefas)" Margin="0,4"/>
                                <CheckBox x:Name="ChkCloseTray" Content="Fechar para a bandeja do sistema ao clicar no 'X' (em vez de encerrar o app)" Margin="0,4"/>
                                <Button Content="💾 Salvar Opções de Janela e Inicialização" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnSaveStartup"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- LOGS -->
                <DockPanel x:Name="ViewLogs" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="🗑️ Limpar" Style="{StaticResource FlatButton}" Background="#b91c1c" Margin="4,0" Click="OnClearLogs"/>
                        <Button DockPanel.Dock="Right" Content="🔄 Recarregar" Style="{StaticResource FlatButton}" Margin="4,0" Click="OnReloadLogs"/>
                        <TextBlock Text="📜 Histórico de Notificações e Auditoria" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="TxtLogs" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource Bg1}" AcceptsReturn="True"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
